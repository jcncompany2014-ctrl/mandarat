{
  "expo": {
    "name": "Mandarat",
    "slug": "mandarat",
    "version": "1.0.0",
    "orientation": "portrait",
    "icon": "./assets/icon.png",
    "scheme": "mandarat",
    "userInterfaceStyle": "automatic",
    "backgroundColor": "#FBF9F4",
    "locales": {
      "ko": "./locales/ko.json",
      "ja": "./locales/ja.json",
      "en": "./locales/en.json"
    },
    "ios": {
      "supportsTablet": true,
      "bundleIdentifier": "com.jcncompany.mandarat",
      "icon": {
        "light": "./assets/icon.png",
        "dark": "./assets/icon-dark.png",
        "tinted": "./assets/icon-tinted.png"
      },
      "entitlements": {
        "com.apple.developer.icloud-container-identifiers": [
          "iCloud.com.jcncompany.mandarat"
        ],
        "com.apple.developer.ubiquity-container-identifiers": [
          "iCloud.com.jcncompany.mandarat"
        ],
        "com.apple.developer.icloud-services": [
          "CloudDocuments"
        ]
      },
      "infoPlist": {
        "CFBundleDisplayName": "만다라트",
        "CFBundleDevelopmentRegion": "ko",
        "CFBundleLocalizations": [
          "ko",
          "ja",
          "en"
        ],
        "RCTAsyncStorageExcludeFromBackup": false,
        "NSPhotoLibraryAddUsageDescription": "만다라트 표 이미지를 사진 앱에 저장하려면 권한이 필요해요.",
        "UIStatusBarStyle": "UIStatusBarStyleDarkContent",
        "ITSAppUsesNonExemptEncryption": false
      },
      "privacyManifests": {
        "NSPrivacyTracking": false,
        "NSPrivacyAccessedAPITypes": [
          {
            "NSPrivacyAccessedAPIType": "NSPrivacyAccessedAPICategoryUserDefaults",
            "NSPrivacyAccessedAPITypeReasons": [
              "CA92.1",
              "1C8F.1"
            ]
          },
          {
            "NSPrivacyAccessedAPIType": "NSPrivacyAccessedAPICategoryFileTimestamp",
            "NSPrivacyAccessedAPITypeReasons": [
              "C617.1"
            ]
          }
        ],
        "NSPrivacyCollectedDataTypes": [
          {
            "NSPrivacyCollectedDataType": "NSPrivacyCollectedDataTypeCrashData",
            "NSPrivacyCollectedDataTypeLinked": false,
            "NSPrivacyCollectedDataTypeTracking": false,
            "NSPrivacyCollectedDataTypePurposes": [
              "NSPrivacyCollectedDataTypePurposeAppFunctionality"
            ]
          },
          {
            "NSPrivacyCollectedDataType": "NSPrivacyCollectedDataTypePerformanceData",
            "NSPrivacyCollectedDataTypeLinked": false,
            "NSPrivacyCollectedDataTypeTracking": false,
            "NSPrivacyCollectedDataTypePurposes": [
              "NSPrivacyCollectedDataTypePurposeAppFunctionality"
            ]
          },
          {
            "NSPrivacyCollectedDataType": "NSPrivacyCollectedDataTypeOtherDiagnosticData",
            "NSPrivacyCollectedDataTypeLinked": false,
            "NSPrivacyCollectedDataTypeTracking": false,
            "NSPrivacyCollectedDataTypePurposes": [
              "NSPrivacyCollectedDataTypePurposeAppFunctionality"
            ]
          }
        ]
      }
    },
    "android": {
      "package": "com.jcncompany.mandarat",
      "adaptiveIcon": {
        "backgroundColor": "#FBF9F4",
        "foregroundImage": "./assets/android-icon-foreground.png",
        "backgroundImage": "./assets/android-icon-background.png",
        "monochromeImage": "./assets/android-icon-monochrome.png"
      },
      "predictiveBackGestureEnabled": false,
      "blockedPermissions": [
        "android.permission.SYSTEM_ALERT_WINDOW",
        "android.permission.READ_EXTERNAL_STORAGE",
        "android.permission.WRITE_EXTERNAL_STORAGE"
      ]
    },
    "web": {
      "favicon": "./assets/favicon.png",
      "bundler": "metro",
      "name": "만다라트",
      "shortName": "만다라트",
      "themeColor": "#FBF9F4",
      "backgroundColor": "#FBF9F4"
    },
    "plugins": [
      "expo-font",
      [
        "expo-splash-screen",
        {
          "backgroundColor": "#FBF9F4",
          "image": "./assets/splash-icon.png",
          "imageWidth": 374,
          "resizeMode": "contain"
        }
      ],
      [
        "expo-localization",
        {
          "supportedLocales": {
            "ios": [
              "ko",
              "ja",
              "en"
            ],
            "android": [
              "ko",
              "ja",
              "en"
            ]
          }
        }
      ],
      "expo-notifications",
      "./plugins/withWidgetStrings",
      [
        "expo-widgets",
        {
          "bundleIdentifier": "com.jcncompany.mandarat.widgets",
          "groupIdentifier": "group.com.jcncompany.mandarat",
          "enablePushNotifications": false,
          "frequentUpdates": false,
          "widgets": [
            {
              "name": "TodayWidget",
              "displayName": "오늘",
              "description": "오늘 할 일과 남은 수를 보여 줘요.",
              "ios": {
                "supportedFamilies": [
                  "systemSmall",
                  "systemMedium",
                  "systemLarge",
                  "accessoryInline",
                  "accessoryCircular",
                  "accessoryRectangular"
                ]
              }
            }
          ]
        }
      ],
      [
        "@sentry/react-native/expo",
        {
          "organization": "farmerstail",
          "project": "mandarat",
          "url": "https://sentry.io/"
        }
      ]
    ],
    "experiments": {
      "inlineModules": {
        "watchedDirectories": [
          "native/ios"
        ]
      }
    }
  }
}
